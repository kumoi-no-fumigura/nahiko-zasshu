  },
  {
   "id": "zokukagaku08-nahiko-zasshu-0010",
   "pid": "993386",
   "pages": [
    111
   ],
   "text": "楫取魚彥雜集さふるこの名をよめる笹の戶のさやぐ荒野ゐかりほして佗しくもあるか夜の秋風近江比國なる人の許より文おこせたるあ返り事すとて言問ひの山川越てゆきかへがふミというべも名づけ初けるあふみぢにありといふなる鏡山まさめふ君を見る由もグも知る人となりて幾程もなく故〓へ歸る人あ久方の空ゆく雲のゆきかへりかたらふまなく別れぬるかな明和五年霜月十七日ふ古言梯あつめをはりて人々集ひうたげすとて大船のかとりのあまのおほけなきかも石の上古き世のこと今刈えしりおきつもはのおとやへつもはのおとや明和七年とらのむつきはさちまりむゆかゑるし終りぬかとりの魚彥楫取魚彥雜集急",
   "poems": [
    "129",
    "130",
    "131",
    "132",
    "133",
    "134"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "明和元年甲申霜月十六日楫取の魚彥がりつどひてその所",
   "kana": "",
   "speaker": "",
   "page": 102,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "中臣のかとりはふりがいはふなるほこ杉の上お雪降あけり",
   "kana": "",
   "speaker": "",
   "page": 102,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ゆふされバうながみグたのれきつ風雲井お吹て千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 102,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "さよふけて兒島のかこのこゑすなり海上グさお月出らしも",
   "kana": "",
   "speaker": "",
   "page": 102,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "夕されバ玄たけ吹らし香取船ふはしまがくれこぎ歸る見ゆ",
   "kana": "",
   "speaker": "",
   "page": 102,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あられふり風さゆる夜ふ鹿島潟かこぞ呼なるきた中おして",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "鹿島がたなごろさかしもさ衣のをつくば風やいさく吹らむ",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "朝日子の光たゞさすかしま潟めでていませるな〓の上比宮",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "玄さの浦けさ漕來れが香取の海みのわたの沖ふ網曳する見ゆ",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "一とせ人々あがたねに集ひて古き都を思ひてよめる",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "日をふとも散ずもあらなん三芳野の瀧の上の櫻見る人此爲",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "さほのうちい花咲みてり然れどもふりにし里い人目乏しも",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "櫻花さくやさグ爲ふるさとの蜻蛉の野邊い人もあらなくお",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "いおしへの大宮人のかざしけんみそのゝ櫻見れバかなしも",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "たれ見よと今も咲けんさいなみの大山守のもりしさくらい",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "櫻花さき北さかりあなりぬれびふりし都のおもほゆるかも",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "うつさへに人ハ見えねど故〓の櫻のみこそむかしなりけれ",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "櫻花さきをゝれどもさいを〓や〓賀の都いひとおともせも",
   "kana": "",
   "speaker": "",
   "page": 103,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "此ゆふべふりさけ見れびむかつをおさける櫻を霞こめたり",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かつらぎやあさづま風の朝たちて豊浦の寺ふさくら花ちる",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "大ふねのかとりの浦ふ花ぞちる息栖のおきお風たつらしも",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "いなび野もゆき過なんを櫻花ちりかふ道あなづミたりけり",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "山風ゐちり來る花のおのれのと谷おい春とかもふべらなり",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "大かさもみらくすくなき櫻花夜あかくれてもちりあける哉",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "さいを〓やひらの大わた風吹りバみなわおうかぶ山櫻かも",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "さくら花ざはおちる山越來れバ我のる駒いつきげとなりぬ",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "散ぬれバちりとなりぬる花ながら花をバいかで踏て過べき",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "彌生の廿日あまり四日あがたゐに人々つどひて",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "まれおざおとふ人もなき古へのみやこH花い色もかはらで",
   "kana": "",
   "speaker": "",
   "page": 104,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "鳥が啼東大城の御門はも多お有ども大御門守賜へる豊國の",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "百たらず八重咲く花の紫陽花の淺らゐけふを思ひやハせむ",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "不知火の筑紫を出てつくし人のけふの遊ふあふぶとをしき",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "昨日といひけふの馬塲の諸きほひきほひて君が宿ふ來あけり",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "れバ橘かざしうたげするけふの手ぶりのとをしくもあるか",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "五月來て射るやうま塲のうま弓の起伏あこそ思ひて有けれ",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "騎射の歸りあるじぞおもほゆるますらを比友けふし遊ベバ",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "友垣を嬉しみと戀ひ集へつゝあしさおハ玉グしはとり夕さ",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "およひゑらぎもすれとはしきやし上代のみやび慕ふなる此",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "天雲のむかふすきはみ照るまであ峰あも尾ゐも花咲ゐけり",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "さくら花さきぬる時い飛火野の野守がやどふ一夜ねぬべし",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "はぬ事しなけれバ鳥が啼東大城につとひ來てお比が幸々歌",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "不知火の筑紫の國も駒の爪津輕の人も天皇の大宮手振到ら",
   "kana": "",
   "speaker": "",
   "page": 105,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "松浦潟まつとないひそ相模なるあしがら山お關もあるもの",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "諸ともふ遊ぶなりけり物の音お聲うちそはる山ほとゝぎす",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "めづらしな雲井のよそお思ひこしもと時鳥けふぞかさらふ",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "めづらしと思へるならし時鳥唯こゝおしもかさらへるむり",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "よき人のめでつるけふのあやめ草かつらみ懸て遊すらしも",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "たちばなの下てる宿いとこしへお榮えぞゆかん今も見る如",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "故〓もけふい近くぞおもほゆるおなじ筑紫の人おあへれバ",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "やちまさあたてる橘かぐはしみ行くも歸るも過がてぬかも",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "皆人の玉ふぬくとふ常世もの長しへおグもと思ほゆるかも",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "お懸て歌およひ酒ゑらぎする五月のけふい忘れじ丈夫の伴",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "しつゝ片へおハ雅言せり風流たる古みし友と菖蒲草かつら",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "しもいくばくもあらぬを天皇の大國グらと片へおい雄建び",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "れびものヽふの八十伴緒を率て仕奉れる日比守夜の守の暇",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "腰に取帶石靱を背びらに負て駒の爪筑紫を立て遠々あ參到",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "雄倉の君お仕ふなる臣い多けど菅原の此主こそい眞黑太刀",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "かさ糸のあはで過して聞つるをあはをあよれる時も有けり",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "菖蒲草かつらおかけて時鳥めづらしきねをも今きくらしも",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "古しへの馬塲お不えて益良夫のけふの遊びぞ樂しかりける",
   "kana": "",
   "speaker": "",
   "page": 106,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "賤がやいなべて蚊やりをたきぬらし遠近わかず烟くゆなり",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "水無月の風吹たえて照日おい水のおもざおかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "藤波のうちゝる時いおちたぎつ瀧つ糸こそあむらさきなれ",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "かつらゐも玄つゝ遊ぶク此宿の長きためしふひける菖蒲も",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "いついといとかぬものから吳竹のちよの始い夏ふぞ有ける",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "皆人の玉ゐぬくなる常世ものとこしへおもとおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "垂乳根の母グかふあのこもりにし心はるくる今日あも有哉",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "むさし野の夏野を分て一もとの草をゆかしみ尋ねきあけり",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "をちかへりむくや五月の時鳥ともあきく日比めづらしき哉",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "思ふ事なき人もめるあさりおい行過ぎがたき物の音ぞする",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "年毎あかくもあらぬか立花のかげふむ道のゆきかへりつゝ",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "五月雨の雲まを見ゆる夕月のたてるばかりをなりまし物を",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "ゆかしくも思ほゆるかも年ふりし友ああふちの花さりる宿",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "風のとの遠きさかひふ年へてもおもとすれせぬ事の嬉しさ",
   "kana": "",
   "speaker": "",
   "page": 107,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "わざもこが植し桑の木玄げれどもつむ人もなし植し桑の木",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "てれる日をいとふ〓〓と思ふまあ年の半比たちあけるかも",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "いざこども此日暮なバかぐりさし心なぐさあ河瀬たゝまし",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "さきぬやと我もふ梅を白雪のちると見るまで降玄きみけり",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "春やきぬ冬や殘れるあまたさび降亥く雪あうぐひすなくも",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "蛙なくきよき河原の川比べの玄だり柳ハ見れどあかぬかも",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "山つみのミつぎとまつる三芳野のよし野の櫻いまも咲らん",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "きさらぎのなかばあなれど花おそき梢を雪ふかして見る哉",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "足がらの八重山こえて都べおなきてゆうなん君よぶこどり",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "打はらひ君がゆきけん雪との〓花のちるまで成あけるかも",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "霞立つ春ハ過れど時々の心ともしも野邊見れバ卯木花さき",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "里わにい藤波あほひ足曳の山時鳥立くぎて初音鳴ぬと里人",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "の吾ふ〓れバはしけやし吾妻の子も人妻もあともひたてゝ",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "ひり鳥の引つゝ行けど武藏なる大河邊よりかのみゆる下つ",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "ふさなるこち〓〓のあがたも見つゝふほ鳥の葛飾小川かは",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "比がり棚おし小舟芦間より漕そけつれバ鳥が啼あづまの都",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "神の御前お幣まつり拜みまつりてそこ見れが森も玄みゝお",
   "kana": "",
   "speaker": "",
   "page": 108,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "藤波のとをゝふ咲て池水比底さへおほひ見る人のクミも照",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "るまで盛なる藤波の花い見れどあかぬかも",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "池水のそこおも匂ふ藤波のな〓お見えじやけふのさかりを",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "た比めつる人まつからふ吾宿のはな立花のちらまくをしも",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "時鳥きけがさぶしもながなくなべふ五月雨のふりおしこと",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "五月雨比ふり出てぞなく時鳥獨あるき〓グわびつゝりねん",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "かゞなべていつかともひし初秋のけふの今宵お成ふける哉",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "我せこを待つゝをれバ天の川はつあきかぜふひれ吹かへす",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "秋風のすゞしくもあるか天の川みふねよそひて今や出らむ",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "天の河かは浪いかお高けれが年をへだてゝつまこひもらむ",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "越がでおいたちなげ々バいとゞしく天の河原お霧さち渡る",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "こよひの〓ほはべき袖を君待つと天の川らの霧お玄をりつ",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "待つ程い久しからめと彥星もたのめしまヽあとふてふ物を",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "秋風いやゝ肌寒くなりあけりをとなへしふぞ宿をからまし",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "夜を寒〓雁ぞ鳴なるふる里のかとりのわたり鳴て來つらむ",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "故〓をこひつゝをれバくさまくら枕の上あかり鳴きわたる",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "旅ゐして物思ひをれがくさまくら人まつ虫の聲ぞわびしき",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "今宵のとてる月あしも有なくお更行く夜半をいねがておする",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "故〓のたヾこゝもとおなりぬるか見馴し月の影のかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "わぎもこをあひつゝをれバ大船の香取の方ゆ月さしのぼる",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "とふ人も宿もかはれと故〓ふかはらぬものい月あざりける",
   "kana": "",
   "speaker": "",
   "page": 109,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "月夜よし夜よし此夜を思ふどち鳥いなくとも遊びてもかむ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "よき人もこゝあつとへり月見むと玄なとの風よ雲吹はらへ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "五百重さつ雲も絕間のなくやいと月待つ程あ夜ぞ更おける",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "ぬば玉の月かたぶきぬ武藏野お立さゝふべき山もあらなむ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "山の端ふかさぶく月を滋しむ間に水底の影もいづちふはむ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "白菊のさける山路の人まさバされもちとせをふる心地ぜむ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "山風のちりまがはせる紅葉かも歸らん方の道も玄らなくお",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "谷川の浪のと高しふひはりの筑波の〓ねおゑぐれふるらし",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "常磐なる伊賀の山邊のいかし代を君が玄くべき限玄らずも",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "苔のむす岩ほおおふる松がねの遠く久しき代をぞへぬべき",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "あふみぢと賴めし事い空しくてなき人こふる日比積りぬる",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "賀茂の吾うしはやさもらへどこととひまさず言とへど答へ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "まさず賀茂のあグうしはやかもの吾うしはや",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "こもり江お隙なく生るねぬなは比苦しくも有ク玄たお懲れが",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "人やりの道ならなくに別れ居て思ひわびつゝ妻とひすらむ",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "女郞花咲や岡邊のかりぶしのひと夜のからお袖のつゆけき",
   "kana": "",
   "speaker": "",
   "page": 110,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "笹の戶のさやぐ荒野ゐかりほして佗しくもあるか夜の秋風",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "言問ひの山川越てゆきかへがふミというべも名づけ初ける",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "あふみぢにありといふなる鏡山まさめふ君を見る由もグも",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "久方の空ゆく雲のゆきかへりかたらふまなく別れぬるかな",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "大船のかとりのあまのおほけなきかも石の上古き世のこと",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "今刈えしりおきつもはのおとやへつもはのおとや",
   "kana": "",
   "speaker": "",
   "page": 111,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
  "work_id": "zokukagaku08-nahiko-zasshu",
